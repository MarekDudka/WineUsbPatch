+/***********************************************************************
+ *           WinUsb_Initialize (winusb.@)
+ */
+BOOL WINAPI WinUsb_Initialize(HANDLE device, WINUSB_INTERFACE_HANDLE *handle)
+{
+    struct winusb_get_descriptor_params params = {USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, 0};
+    struct winusb_claim_params claim = {0};
+    USB_CONFIGURATION_DESCRIPTOR header;
+    struct winusb *winusb;
+    const UCHAR *p, *end;
+    DWORD size;
+
+    TRACE("device %p, handle %p.\n", device, handle);
+
+    if (!handle || device == INVALID_HANDLE_VALUE)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+
+    if (!(winusb = calloc(1, sizeof(*winusb))))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    winusb->device = device;
+
+    /* Read the configuration descriptor, first its header, then everything. */
+    params.length = sizeof(header);
+    if (!device_ioctl(winusb, IOCTL_WINEUSB_GET_DESCRIPTOR, &params, sizeof(params),
+            &header, sizeof(header), &size, NULL) || size < sizeof(header))
+    {
+        WARN("Failed to read the configuration descriptor, error %lu.\n", GetLastError());
+        goto fail;
+    }
+
+    params.length = header.wTotalLength;
+    if (!(winusb->config = malloc(params.length)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        goto fail;
+    }
+    if (!device_ioctl(winusb, IOCTL_WINEUSB_GET_DESCRIPTOR, &params, sizeof(params),
+            winusb->config, params.length, &size, NULL))
+    {
+        WARN("Failed to read the configuration descriptor, error %lu.\n", GetLastError());
+        goto fail;
+    }
+    winusb->config_length = size;
+
+    /* WinUSB binds to the first interface of the configuration. */
+    p = winusb->config;
+    end = p + winusb->config_length;
+    winusb->interface_number = 0;
+    while (p + 2 <= end && p[0] >= 2 && p + p[0] <= end)
+    {
+        if (p[1] == USB_INTERFACE_DESCRIPTOR_TYPE && p[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            winusb->interface_number = ((const USB_INTERFACE_DESCRIPTOR *)p)->bInterfaceNumber;
+            break;
+        }
+        p += p[0];
+    }
+    winusb->alt_setting = 0;
+    parse_pipes(winusb);
+
+    claim.interface = winusb->interface_number;
+    if (!device_ioctl(winusb, IOCTL_WINEUSB_CLAIM, &claim, sizeof(claim), NULL, 0, NULL, NULL))
+        WARN("Failed to claim interface %u, error %lu.\n", claim.interface, GetLastError());
+
+    TRACE("Initialized interface %u with %u pipes.\n", winusb->interface_number, winusb->pipe_count);
+    *handle = winusb;
+    return TRUE;
+
+fail:
+    free(winusb->config);
+    free(winusb);
+    return FALSE;
+}
 
