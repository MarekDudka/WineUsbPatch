+/* User-mode interface, used by winusb.dll. */
+
+struct user_request
+{
+    IRP *user_irp;
+    URB urb;
+    void *buffer;
+    ULONG buffer_size;
+    BOOL in;
+};
+
+static const GUID guid_devinterface_usb_device =
+        {0xa5dcbf10, 0x6530, 0x11d2, {0x90, 0x1f, 0x00, 0xc0, 0x4f, 0xb9, 0x51, 0xed}};
+
+static void *make_pipe_handle(UINT8 endpoint, UINT8 type)
+{
+    union
+    {
+        struct { unsigned char endpoint, type; } pipe;
+        void *handle;
+    } u = {0};
+
+    u.pipe.endpoint = endpoint;
+    u.pipe.type = type;
+    return u.handle;
+}
+
+static NTSTATUS status_from_usbd(USBD_STATUS status, NTSTATUS irp_status)
+{
+    if (irp_status != STATUS_SUCCESS)
+        return irp_status;
+    if (USBD_SUCCESS(status))
+        return STATUS_SUCCESS;
+    switch (status)
+    {
+        case USBD_STATUS_TIMEOUT: return STATUS_IO_TIMEOUT;
+        case USBD_STATUS_CANCELED: return STATUS_CANCELLED;
+        case USBD_STATUS_DEVICE_GONE: return STATUS_DEVICE_NOT_CONNECTED;
+        default: return STATUS_UNSUCCESSFUL;
+    }
+}
+
+static NTSTATUS WINAPI user_request_complete(DEVICE_OBJECT *device_obj, IRP *irp, void *context)
+{
+    struct user_request *req = context;
+    IRP *user_irp = req->user_irp;
+    ULONG_PTR info = 0;
+    NTSTATUS status;
+
+    status = status_from_usbd(req->urb.UrbHeader.Status, irp->IoStatus.Status);
+
+    if (status == STATUS_SUCCESS)
+    {
+        switch (req->urb.UrbHeader.Function)
+        {
+            case URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER:
+                info = req->urb.UrbBulkOrInterruptTransfer.TransferBufferLength;
+                break;
+            case URB_FUNCTION_CONTROL_TRANSFER:
+                info = req->urb.UrbControlTransfer.TransferBufferLength;
+                break;
+            case URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE:
+                info = req->urb.UrbControlDescriptorRequest.TransferBufferLength;
+                break;
+        }
+        if (!req->in)
+            info = 0;
+        else if (info > req->buffer_size)
+            info = req->buffer_size;
+        if (info)
+            memcpy(user_irp->AssociatedIrp.SystemBuffer, req->buffer, info);
+    }
+    else if (status != STATUS_CANCELLED)
+        WARN("Request failed, usbd status %#lx, status %#lx.\n", (long)req->urb.UrbHeader.Status, status);
+
+    user_irp->IoStatus.Status = status;
+    user_irp->IoStatus.Information = info;
+    IoCompleteRequest(user_irp, IO_NO_INCREMENT);
+
+    ExFreePool(req->buffer);
+    ExFreePool(req);
+    IoFreeIrp(irp);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+/* Takes ownership of req on success; the user IRP is completed asynchronously. */
+static NTSTATUS submit_user_request(struct usb_device *device, IRP *user_irp,
+        struct user_request *req, ULONG timeout)
+{
+    IO_STACK_LOCATION *stack;
+    IRP *irp;
+
+    if (!(irp = IoAllocateIrp(2, FALSE)))
+        return STATUS_NO_MEMORY;
+
+    req->user_irp = user_irp;
+    req->urb.UrbHeader.Length = sizeof(req->urb);
+
+    stack = IoGetNextIrpStackLocation(irp);
+    stack->MajorFunction = IRP_MJ_INTERNAL_DEVICE_CONTROL;
+    stack->Parameters.DeviceIoControl.IoControlCode = IOCTL_INTERNAL_USB_SUBMIT_URB;
+    stack->Parameters.Others.Argument1 = &req->urb;
+    irp->Tail.Overlay.DriverContext[1] = (void *)(ULONG_PTR)timeout;
+    IoSetCompletionRoutine(irp, user_request_complete, req, TRUE, TRUE, TRUE);
+
+    IoMarkIrpPending(user_irp);
+    IoCallDriver(device->device_obj, irp);
+    return STATUS_PENDING;
+}
+
+static struct user_request *alloc_request(ULONG buffer_size)
+{
+    struct user_request *req;
+
+    if (!(req = ExAllocatePool(NonPagedPool, sizeof(*req))))
+        return NULL;
+    memset(req, 0, sizeof(*req));
+    if (!(req->buffer = ExAllocatePool(NonPagedPool, max(buffer_size, 1))))
+    {
+        ExFreePool(req);
+        return NULL;
+    }
+    memset(req->buffer, 0, max(buffer_size, 1));
+    req->buffer_size = buffer_size;
+    return req;
+}
+
+static void free_request(struct user_request *req)
+{
+    ExFreePool(req->buffer);
+    ExFreePool(req);
+}
+
+static NTSTATUS user_ioctl(struct usb_device *device, IRP *irp, ULONG code)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG in_size = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    unsigned char *in = irp->AssociatedIrp.SystemBuffer;
+    struct user_request *req;
+    NTSTATUS status;
+
+    switch (code)
+    {
+        case IOCTL_WINEUSB_GET_DESCRIPTOR:
+        {
+            const struct winusb_get_descriptor_params *params = (void *)in;
+            struct _URB_CONTROL_DESCRIPTOR_REQUEST *desc;
+            ULONG length;
+
+            if (in_size < sizeof(*params)) return STATUS_INVALID_PARAMETER;
+            length = min(params->length, out_size);
+            if (!(req = alloc_request(length))) return STATUS_NO_MEMORY;
+            req->in = TRUE;
+            desc = &req->urb.UrbControlDescriptorRequest;
+            desc->Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+            desc->TransferBufferLength = length;
+            desc->TransferBuffer = req->buffer;
+            desc->Index = params->index;
+            desc->DescriptorType = params->type;
+            desc->LanguageId = params->language;
+            break;
+        }
+
+        case IOCTL_WINEUSB_CLAIM:
+        {
+            const struct winusb_claim_params *params = (void *)in;
+            struct _URB_SELECT_CONFIGURATION *select;
+
+            if (in_size < sizeof(*params)) return STATUS_INVALID_PARAMETER;
+            if (!(req = alloc_request(0))) return STATUS_NO_MEMORY;
+            select = &req->urb.UrbSelectConfiguration;
+            select->Hdr.Function = URB_FUNCTION_SELECT_CONFIGURATION;
+            select->Interface.Length = sizeof(select->Interface);
+            select->Interface.InterfaceNumber = params->interface;
+            select->Interface.AlternateSetting = params->alt_setting;
+            break;
+        }
+
+        case IOCTL_WINEUSB_TRANSFER:
+        {
+            const struct winusb_transfer_params *params = (void *)in;
+            struct _URB_BULK_OR_INTERRUPT_TRANSFER *xfer;
+            ULONG timeout;
+
+            if (in_size < sizeof(*params)) return STATUS_INVALID_PARAMETER;
+            timeout = params->timeout;
+            if (params->pipe.endpoint & 0x80)
+            {
+                if (params->length > out_size) return STATUS_BUFFER_TOO_SMALL;
+                if (!(req = alloc_request(params->length))) return STATUS_NO_MEMORY;
+                req->in = TRUE;
+            }
+            else
+            {
+                if (params->length > in_size - sizeof(*params)) return STATUS_INVALID_PARAMETER;
+                if (!(req = alloc_request(params->length))) return STATUS_NO_MEMORY;
+                memcpy(req->buffer, in + sizeof(*params), params->length);
+            }
+            xfer = &req->urb.UrbBulkOrInterruptTransfer;
+            xfer->Hdr.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+            xfer->PipeHandle = make_pipe_handle(params->pipe.endpoint, params->pipe.type);
+            xfer->TransferFlags = (params->pipe.endpoint & 0x80) ? USBD_TRANSFER_DIRECTION_IN : 0;
+            xfer->TransferBufferLength = params->length;
+            xfer->TransferBuffer = req->buffer;
+            status = submit_user_request(device, irp, req, timeout);
+            if (status != STATUS_PENDING) free_request(req);
+            return status;
+        }
+
+        case IOCTL_WINEUSB_CONTROL:
+        {
+            const struct winusb_control_params *params = (void *)in;
+            struct _URB_CONTROL_TRANSFER *ctrl;
+            ULONG timeout;
+            BOOL is_in;
+
+            if (in_size < sizeof(*params)) return STATUS_INVALID_PARAMETER;
+            timeout = params->timeout;
+            is_in = !!(params->request_type & 0x80);
+            if (is_in && params->length > out_size) return STATUS_BUFFER_TOO_SMALL;
+            if (!is_in && params->length > in_size - sizeof(*params)) return STATUS_INVALID_PARAMETER;
+            if (!(req = alloc_request(params->length))) return STATUS_NO_MEMORY;
+            req->in = is_in;
+            if (!is_in) memcpy(req->buffer, in + sizeof(*params), params->length);
+            ctrl = &req->urb.UrbControlTransfer;
+            ctrl->Hdr.Function = URB_FUNCTION_CONTROL_TRANSFER;
+            ctrl->TransferFlags = is_in ? USBD_TRANSFER_DIRECTION_IN : 0;
+            ctrl->TransferBufferLength = params->length;
+            ctrl->TransferBuffer = req->buffer;
+            ctrl->SetupPacket[0] = params->request_type;
+            ctrl->SetupPacket[1] = params->request;
+            ctrl->SetupPacket[2] = params->value;
+            ctrl->SetupPacket[3] = params->value >> 8;
+            ctrl->SetupPacket[4] = params->index;
+            ctrl->SetupPacket[5] = params->index >> 8;
+            ctrl->SetupPacket[6] = params->length;
+            ctrl->SetupPacket[7] = params->length >> 8;
+            status = submit_user_request(device, irp, req, timeout);
+            if (status != STATUS_PENDING) free_request(req);
+            return status;
+        }
+
+        case IOCTL_WINEUSB_RESET_PIPE:
+        case IOCTL_WINEUSB_ABORT_PIPE:
+        {
+            const struct winusb_pipe_params *params = (void *)in;
+
+            if (in_size < sizeof(*params)) return STATUS_INVALID_PARAMETER;
+            if (!(req = alloc_request(0))) return STATUS_NO_MEMORY;
+            req->urb.UrbPipeRequest.Hdr.Function = (code == IOCTL_WINEUSB_RESET_PIPE)
+                    ? URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL : URB_FUNCTION_ABORT_PIPE;
+            req->urb.UrbPipeRequest.PipeHandle = make_pipe_handle(params->endpoint, params->type);
+            break;
+        }
+
+        default:
+            return STATUS_NOT_IMPLEMENTED;
+    }
+
+    status = submit_user_request(device, irp, req, 0);
+    if (status != STATUS_PENDING) free_request(req);
+    return status;
+}
+
+static NTSTATUS WINAPI driver_device_control(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    struct usb_device *device = device_obj->DeviceExtension;
+    NTSTATUS status;
+    BOOL removed;
+
+    TRACE("device_obj %p, irp %p, code %#lx.\n", device_obj, irp, code);
+
+    if (device_obj == bus_fdo)
+        status = STATUS_NOT_SUPPORTED;
+    else
+    {
+        EnterCriticalSection(&wineusb_cs);
+        removed = device->removed;
+        LeaveCriticalSection(&wineusb_cs);
+
+        status = removed ? STATUS_DELETE_PENDING : user_ioctl(device, irp, code);
+    }
+
+    if (status != STATUS_PENDING)
+    {
+        irp->IoStatus.Status = status;
+        irp->IoStatus.Information = 0;
+        IoCompleteRequest(irp, IO_NO_INCREMENT);
+    }
+    return status;
+}
+
+static NTSTATUS WINAPI driver_create_close(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    irp->IoStatus.Status = (device_obj == bus_fdo) ? STATUS_NOT_SUPPORTED : STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return irp->IoStatus.Status;
+}
+
+static NTSTATUS WINAPI driver_cleanup(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    if (device_obj != bus_fdo)
+    {
+        struct usb_device *device = device_obj->DeviceExtension;
+        LIST_ENTRY *entry, *mark;
+
+        /* The handle is going away; cancel whatever is still outstanding. */
+        EnterCriticalSection(&wineusb_cs);
+        mark = &device->irp_list;
+        for (entry = mark->Flink; entry != mark; entry = entry->Flink)
+        {
+            IRP *queued_irp = CONTAINING_RECORD(entry, IRP, Tail.Overlay.ListEntry);
+            struct usb_cancel_transfer_params params =
+            {
+                .transfer = queued_irp->Tail.Overlay.DriverContext[0],
+            };
+
+            WINE_UNIX_CALL(unix_usb_cancel_transfer, &params);
+        }
+        LeaveCriticalSection(&wineusb_cs);
+    }
+
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = 0;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return STATUS_SUCCESS;
+}
+
+/* Expose the device through the interface GUIDs the application looks for.
+ * The GUIDs come from the DeviceInterfaceGUIDs value of the device's
+ * "Device Parameters" key (as set by a WinUSB INF), or failing that, from
+ * HKLM\Software\Wine\WineUSB\VID_xxxx&PID_xxxx. */
+static BOOL read_guid_list(HANDLE key, WCHAR **list)
+{
+    static const WCHAR name[] = L"DeviceInterfaceGUIDs";
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UNICODE_STRING value_name;
+    ULONG size = 0;
+    NTSTATUS status;
+
+    RtlInitUnicodeString(&value_name, name);
+    status = ZwQueryValueKey(key, &value_name, KeyValuePartialInformation, NULL, 0, &size);
+    if (status != STATUS_BUFFER_TOO_SMALL && status != STATUS_BUFFER_OVERFLOW) return FALSE;
+    if (!(info = ExAllocatePool(NonPagedPool, size + sizeof(WCHAR) * 2))) return FALSE;
+    if (ZwQueryValueKey(key, &value_name, KeyValuePartialInformation, info, size, &size)
+            || (info->Type != REG_MULTI_SZ && info->Type != REG_SZ))
+    {
+        ExFreePool(info);
+        return FALSE;
+    }
+    memset(info->Data + info->DataLength, 0, sizeof(WCHAR) * 2);
+    *list = (WCHAR *)info;
+    return TRUE;
+}
+
+static void register_interface(struct usb_device *device, const GUID *guid)
+{
+    UNICODE_STRING link;
+    NTSTATUS status;
+
+    TRACE("device %p, guid %s.\n", device, debugstr_guid(guid));
+    if (device->interface_count >= ARRAY_SIZE(device->interface_links)) return;
+
+    if ((status = IoRegisterDeviceInterface(device->device_obj, guid, NULL, &link)))
+    {
+        ERR("Failed to register device interface, status %#lx.\n", status);
+        return;
+    }
+    TRACE("Registered interface %s.\n", debugstr_w(link.Buffer));
+    if ((status = IoSetDeviceInterfaceState(&link, TRUE)))
+    {
+        ERR("Failed to enable device interface, status %#lx.\n", status);
+        RtlFreeUnicodeString(&link);
+        return;
+    }
+    device->interface_links[device->interface_count++] = link;
+}
+
+static void register_device_interfaces(struct usb_device *device)
+{
+    static const WCHAR base[] = L"\\Registry\\Machine\\Software\\Wine\\WineUSB\\";
+    KEY_VALUE_PARTIAL_INFORMATION *info = NULL;
+    OBJECT_ATTRIBUTES attr = {sizeof(attr)};
+    UNICODE_STRING path;
+    HANDLE key = NULL;
+    WCHAR *list = NULL, *p;
+    WCHAR buffer[128];
+
+    TRACE("Registering interfaces for device %p.\n", device);
+    register_interface(device, &guid_devinterface_usb_device);
+
+    if (!IoOpenDeviceRegistryKey(device->device_obj, PLUGPLAY_REGKEY_DEVICE, KEY_READ, &key))
+    {
+        if (!read_guid_list(key, &list)) list = NULL;
+        ZwClose(key);
+    }
+
+    if (!list)
+    {
+        swprintf(buffer, ARRAY_SIZE(buffer), L"%lsVID_%04X&PID_%04X", base, device->vendor, device->product);
+        RtlInitUnicodeString(&path, buffer);
+        attr.ObjectName = &path;
+        attr.Attributes = OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE;
+        if (!ZwOpenKey(&key, KEY_READ, &attr))
+        {
+            if (!read_guid_list(key, &list)) list = NULL;
+            ZwClose(key);
+        }
+    }
+
+    if (!list) return;
+    info = (KEY_VALUE_PARTIAL_INFORMATION *)list;
+    for (p = (WCHAR *)info->Data; *p; p += wcslen(p) + 1)
+    {
+        UNICODE_STRING string;
+        GUID guid;
+
+        RtlInitUnicodeString(&string, p);
+        if (RtlGUIDFromString(&string, &guid))
+        {
+            WARN("Invalid interface GUID %s.\n", debugstr_w(p));
+            continue;
+        }
+        register_interface(device, &guid);
+    }
+    ExFreePool(info);
+}
+
+static void unregister_device_interfaces(struct usb_device *device)
+{
+    unsigned int i;
+
+    for (i = 0; i < device->interface_count; ++i)
+    {
+        IoSetDeviceInterfaceState(&device->interface_links[i], FALSE);
+        RtlFreeUnicodeString(&device->interface_links[i]);
+    }
+    device->interface_count = 0;
+}
