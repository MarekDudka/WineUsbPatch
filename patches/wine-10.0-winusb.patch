+BOOL WINAPI WinUsb_QueryPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR alt_setting, UCHAR index,
+        WINUSB_PIPE_INFORMATION *info)
+{
+    struct winusb *winusb = handle;
+    const struct pipe_info *pipe;
+
+    TRACE("handle %p, alt_setting %u, index %u, info %p.\n", handle, alt_setting, index, info);
+
+    if (!winusb || !info)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (alt_setting != winusb->alt_setting)
+    {
+        FIXME("Querying pipes of non-current alternate setting %u is not supported.\n", alt_setting);
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+    if (index >= winusb->pipe_count)
+    {
+        SetLastError(ERROR_NO_MORE_ITEMS);
+        return FALSE;
+    }
+
+    pipe = &winusb->pipes[index];
+    info->PipeType = pipe->type;
+    info->PipeId = pipe->address;
+    info->MaximumPacketSize = pipe->max_packet;
+    info->Interval = pipe->interval;
