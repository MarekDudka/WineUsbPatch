+/***********************************************************************
+ *           WinUsb_GetCurrentAlternateSetting (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetCurrentAlternateSetting(WINUSB_INTERFACE_HANDLE handle, UCHAR *alt_setting)
