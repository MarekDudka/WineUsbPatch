--- /dev/null
+++ b/dlls/winusb/winusb_ioctl.h
@@ -0,0 +1,74 @@
+/*
+ * Private interface between winusb.dll and wineusb.sys
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINUSB_IOCTL_H
+#define __WINE_WINUSB_IOCTL_H
+
+#include <stdint.h>
+#include <winioctl.h>
+
+#define WINEUSB_IOCTL(n) CTL_CODE(FILE_DEVICE_UNKNOWN, 0x900 + (n), METHOD_BUFFERED, FILE_ANY_ACCESS)
+
+/* in: struct winusb_get_descriptor_params, out: descriptor bytes */
+#define IOCTL_WINEUSB_GET_DESCRIPTOR  WINEUSB_IOCTL(1)
+/* in: struct winusb_claim_params */
+#define IOCTL_WINEUSB_CLAIM           WINEUSB_IOCTL(2)
+/* in: struct winusb_transfer_params (+ data for OUT), out: data for IN */
+#define IOCTL_WINEUSB_TRANSFER        WINEUSB_IOCTL(3)
+/* in: struct winusb_control_params (+ data for OUT), out: data for IN */
+#define IOCTL_WINEUSB_CONTROL         WINEUSB_IOCTL(4)
+/* in: struct winusb_pipe_params */
+#define IOCTL_WINEUSB_RESET_PIPE      WINEUSB_IOCTL(5)
+/* in: struct winusb_pipe_params */
+#define IOCTL_WINEUSB_ABORT_PIPE      WINEUSB_IOCTL(6)
+
+struct winusb_get_descriptor_params
+{
+    uint8_t type, index;
+    uint16_t language;
+    uint32_t length;
+};
+
+struct winusb_claim_params
+{
+    uint8_t interface, alt_setting;
+    uint16_t padding;
+};
+
+struct winusb_pipe_params
+{
+    uint8_t endpoint;
+    uint8_t type; /* USBD_PIPE_TYPE */
+    uint16_t padding;
+};
+
+struct winusb_transfer_params
+{
+    struct winusb_pipe_params pipe;
+    uint32_t length;
+    uint32_t timeout; /* milliseconds, 0 for infinite */
+};
+
+struct winusb_control_params
+{
+    uint8_t request_type, request;
+    uint16_t value, index, length;
+    uint32_t timeout;
+};
+
+#endif
