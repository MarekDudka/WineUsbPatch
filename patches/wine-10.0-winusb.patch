+}
+
+/***********************************************************************
+ *           WinUsb_SetCurrentAlternateSetting (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetCurrentAlternateSetting(WINUSB_INTERFACE_HANDLE handle, UCHAR alt_setting)
+{
+    struct winusb *winusb = handle;
+    struct winusb_claim_params params = {0};
+
+    TRACE("handle %p, alt_setting %u.\n", handle, alt_setting);
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    params.interface = winusb->interface_number;
+    params.alt_setting = alt_setting;
+    if (!device_ioctl(winusb, IOCTL_WINEUSB_CLAIM, &params, sizeof(params), NULL, 0, NULL, NULL))
+        return FALSE;
+    winusb->alt_setting = alt_setting;
+    parse_pipes(winusb);
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetDescriptor (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetDescriptor(WINUSB_INTERFACE_HANDLE handle, UCHAR type, UCHAR index, USHORT language,
+        UCHAR *buffer, ULONG length, ULONG *transferred)
+{
+    struct winusb *winusb = handle;
+    struct winusb_get_descriptor_params params = {type, index, language, length};
+    DWORD size = 0;
+    BOOL ret;
+
+    TRACE("handle %p, type %#x, index %u, language %#x, buffer %p, length %lu, transferred %p.\n",
+            handle, type, index, language, buffer, length, transferred);
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    ret = device_ioctl(winusb, IOCTL_WINEUSB_GET_DESCRIPTOR, &params, sizeof(params),
+            buffer, length, &size, NULL);
+    if (ret && transferred) *transferred = size;
+    return ret;
+}
+
+/***********************************************************************
+ *           WinUsb_ControlTransfer (winusb.@)
+ */
+BOOL WINAPI WinUsb_ControlTransfer(WINUSB_INTERFACE_HANDLE handle, WINUSB_SETUP_PACKET setup, UCHAR *buffer,
+        ULONG length, ULONG *transferred, OVERLAPPED *overlapped)
+{
+    struct winusb *winusb = handle;
+    struct winusb_control_params *params;
+    BOOL ret, is_in = !!(setup.RequestType & 0x80);
+    DWORD in_size = sizeof(*params), size = 0;
+    UCHAR *in;
+
+    TRACE("handle %p, request_type %#x, request %#x, value %#x, index %#x, length %#x, buffer %p, "
+            "buffer_length %lu, transferred %p, overlapped %p.\n", handle, setup.RequestType, setup.Request,
+            setup.Value, setup.Index, setup.Length, buffer, length, transferred, overlapped);
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (length > setup.Length) length = setup.Length;
+
+    if (!is_in) in_size += length;
+    if (!(in = calloc(1, in_size)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    params = (void *)in;
+    params->request_type = setup.RequestType;
+    params->request = setup.Request;
+    params->value = setup.Value;
+    params->index = setup.Index;
+    params->length = length;
+    params->timeout = 0;
+    if (!is_in && length) memcpy(in + sizeof(*params), buffer, length);
+
+    ret = device_ioctl(winusb, IOCTL_WINEUSB_CONTROL, in, in_size, is_in ? buffer : NULL,
+            is_in ? length : 0, &size, overlapped);
+    if (overlapped && !is_in && (ret || GetLastError() == ERROR_IO_PENDING)) remember_write(overlapped, length);
+    {
+        char extra[64];
+        snprintf(extra, sizeof(extra), " setup=%02x/%02x/%04x/%04x/%04x", setup.RequestType, setup.Request,
+                setup.Value, setup.Index, setup.Length);
+        if (!is_in) capture("CTL-OUT", 0, buffer, length, extra);
+        else if (overlapped) remember_read(overlapped, buffer, 0);
+        else capture("CTL-IN ", 0, buffer, size, extra);
+    }
+    if (ret && transferred) *transferred = is_in ? size : length;
+    free(in);
+    return ret;
+}
+
+static BOOL pipe_transfer(struct winusb *winusb, UCHAR address, UCHAR *buffer, ULONG length,
+        ULONG *transferred, OVERLAPPED *overlapped, BOOL read)
+{
+    struct winusb_transfer_params *params;
+    struct pipe_info *pipe;
+    DWORD in_size = sizeof(*params), size = 0;
+    UCHAR *in;
+    BOOL ret;
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!(pipe = find_pipe(winusb, address))) return FALSE;
+    if (!!(address & 0x80) != read)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (pipe->type != UsbdPipeTypeBulk && pipe->type != UsbdPipeTypeInterrupt)
+    {
+        FIXME("Unsupported pipe type %u.\n", pipe->type);
+        SetLastError(ERROR_NOT_SUPPORTED);
+        return FALSE;
+    }
+
+    if (!read) in_size += length;
+    if (!(in = calloc(1, in_size)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        return FALSE;
+    }
+    params = (void *)in;
+    params->pipe.endpoint = address;
+    params->pipe.type = pipe->type;
+    params->length = length;
+    params->timeout = pipe->timeout;
+    if (!read && length) memcpy(in + sizeof(*params), buffer, length);
+
+    ret = device_ioctl(winusb, IOCTL_WINEUSB_TRANSFER, in, in_size, read ? buffer : NULL,
+            read ? length : 0, &size, overlapped);
+    if (overlapped && !read && (ret || GetLastError() == ERROR_IO_PENDING)) remember_write(overlapped, length);
+    if (!read) capture("OUT", address, buffer, length, ret || GetLastError() == ERROR_IO_PENDING ? "" : " FAILED");
+    else if (overlapped) remember_read(overlapped, buffer, address);
+    else if (ret) capture("IN ", address, buffer, size, "");
+    else capture("IN ", address, buffer, 0, " FAILED");
+    if (ret && transferred) *transferred = read ? size : length;
+    free(in);
+    return ret;
+}
+
+/***********************************************************************
+ *           WinUsb_ReadPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_ReadPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR address, UCHAR *buffer, ULONG length,
+        ULONG *transferred, OVERLAPPED *overlapped)
+{
+    TRACE("handle %p, address %#x, buffer %p, length %lu, transferred %p, overlapped %p.\n",
+            handle, address, buffer, length, transferred, overlapped);
+
+    return pipe_transfer(handle, address, buffer, length, transferred, overlapped, TRUE);
+}
+
+/***********************************************************************
+ *           WinUsb_WritePipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_WritePipe(WINUSB_INTERFACE_HANDLE handle, UCHAR address, UCHAR *buffer, ULONG length,
+        ULONG *transferred, OVERLAPPED *overlapped)
+{
+    TRACE("handle %p, address %#x, buffer %p, length %lu, transferred %p, overlapped %p.\n",
+            handle, address, buffer, length, transferred, overlapped);
+
+    return pipe_transfer(handle, address, buffer, length, transferred, overlapped, FALSE);
+}
+
+/***********************************************************************
+ *           WinUsb_GetOverlappedResult (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetOverlappedResult(WINUSB_INTERFACE_HANDLE handle, OVERLAPPED *overlapped,
+        DWORD *transferred, BOOL wait)
+{
+    struct winusb *winusb = handle;
+
+    TRACE("handle %p, overlapped %p, transferred %p, wait %d.\n", handle, overlapped, transferred, wait);
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    {
+        BOOL ret = GetOverlappedResult(winusb->device, overlapped, transferred, wait);
+        DWORD length;
+
+        if (ret && take_write(overlapped, &length) && transferred) *transferred = length;
+        if (ret) complete_read(overlapped, overlapped->InternalHigh);
+        return ret;
+    }
+}
+
+static BOOL pipe_request(WINUSB_INTERFACE_HANDLE handle, UCHAR address, DWORD code)
+{
+    struct winusb *winusb = handle;
+    struct winusb_pipe_params params = {0};
+    struct pipe_info *pipe;
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!(pipe = find_pipe(winusb, address))) return FALSE;
+    params.endpoint = address;
+    params.type = pipe->type;
+    return device_ioctl(winusb, code, &params, sizeof(params), NULL, 0, NULL, NULL);
+}
+
+/***********************************************************************
+ *           WinUsb_ResetPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_ResetPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR address)
+{
+    TRACE("handle %p, address %#x.\n", handle, address);
+
+    return pipe_request(handle, address, IOCTL_WINEUSB_RESET_PIPE);
+}
+
+/***********************************************************************
+ *           WinUsb_AbortPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_AbortPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR address)
+{
+    TRACE("handle %p, address %#x.\n", handle, address);
+
+    return pipe_request(handle, address, IOCTL_WINEUSB_ABORT_PIPE);
+}
+
+/***********************************************************************
+ *           WinUsb_FlushPipe (winusb.@)
+ */
+BOOL WINAPI WinUsb_FlushPipe(WINUSB_INTERFACE_HANDLE handle, UCHAR address)
+{
+    struct winusb *winusb = handle;
+
+    TRACE("handle %p, address %#x.\n", handle, address);
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    /* There is no host-side buffering to drop. */
+    return find_pipe(winusb, address) != NULL;
+}
+
+/***********************************************************************
+ *           WinUsb_SetPipePolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetPipePolicy(WINUSB_INTERFACE_HANDLE handle, UCHAR address, ULONG type,
+        ULONG length, void *value)
+{
+    struct winusb *winusb = handle;
+    struct pipe_info *pipe;
+
+    TRACE("handle %p, address %#x, type %#lx, length %lu, value %p.\n", handle, address, type, length, value);
+
+    if (!winusb)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!(pipe = find_pipe(winusb, address))) return FALSE;
+
+    switch (type)
+    {
+        case PIPE_TRANSFER_TIMEOUT:
+            if (length != sizeof(ULONG) || !value)
+            {
+                SetLastError(ERROR_INVALID_PARAMETER);
+                return FALSE;
+            }
+            pipe->timeout = *(ULONG *)value;
+            return TRUE;
+
+        case SHORT_PACKET_TERMINATE:
+        case AUTO_CLEAR_STALL:
+        case IGNORE_SHORT_PACKETS:
+        case ALLOW_PARTIAL_READS:
+        case AUTO_FLUSH:
+        case RAW_IO:
+        case RESET_PIPE_ON_RESUME:
+            FIXME("Pipe policy %#lx is accepted but not implemented.\n", type);
+            return TRUE;
+
+        default:
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+    }
+}
+
+/***********************************************************************
+ *           WinUsb_GetPipePolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetPipePolicy(WINUSB_INTERFACE_HANDLE handle, UCHAR address, ULONG type,
+        ULONG *length, void *value)
+{
+    struct winusb *winusb = handle;
+    struct pipe_info *pipe;
+
+    TRACE("handle %p, address %#x, type %#lx, length %p, value %p.\n", handle, address, type, length, value);
+
+    if (!winusb || !length || !value)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (!(pipe = find_pipe(winusb, address))) return FALSE;
+
+    switch (type)
+    {
+        case PIPE_TRANSFER_TIMEOUT:
+        case MAXIMUM_TRANSFER_SIZE:
+            if (*length < sizeof(ULONG))
+            {
+                *length = sizeof(ULONG);
+                SetLastError(ERROR_INSUFFICIENT_BUFFER);
+                return FALSE;
+            }
+            *(ULONG *)value = (type == PIPE_TRANSFER_TIMEOUT) ? pipe->timeout : 0x10000;
+            *length = sizeof(ULONG);
+            return TRUE;
+
+        case SHORT_PACKET_TERMINATE:
+        case AUTO_CLEAR_STALL:
+        case IGNORE_SHORT_PACKETS:
+        case ALLOW_PARTIAL_READS:
+        case AUTO_FLUSH:
+        case RAW_IO:
+        case RESET_PIPE_ON_RESUME:
+            if (*length < sizeof(UCHAR))
+            {
+                *length = sizeof(UCHAR);
+                SetLastError(ERROR_INSUFFICIENT_BUFFER);
+                return FALSE;
+            }
+            *(UCHAR *)value = 0;
+            *length = sizeof(UCHAR);
+            return TRUE;
+
+        default:
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+    }
+}
+
+/***********************************************************************
+ *           WinUsb_SetPowerPolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_SetPowerPolicy(WINUSB_INTERFACE_HANDLE handle, ULONG type, ULONG length, void *value)
+{
+    FIXME("handle %p, type %#lx, length %lu, value %p: ignored.\n", handle, type, length, value);
+
+    if (!handle)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *           WinUsb_GetPowerPolicy (winusb.@)
+ */
+BOOL WINAPI WinUsb_GetPowerPolicy(WINUSB_INTERFACE_HANDLE handle, ULONG type, ULONG *length, void *value)
+{
+    FIXME("handle %p, type %#lx, length %p, value %p: returning zero.\n", handle, type, length, value);
+
+    if (!handle || !length || !value)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (*length) memset(value, 0, *length);
     return TRUE;
 }
+
+/***********************************************************************
+ *           WinUsb_ParseDescriptors (winusb.@)
+ */
+USB_COMMON_DESCRIPTOR * WINAPI WinUsb_ParseDescriptors(void *buffer, ULONG length, void *start, LONG type)
+{
+    UCHAR *p = start, *begin = buffer, *end = begin + length;
+
+    TRACE("buffer %p, length %lu, start %p, type %ld.\n", buffer, length, start, type);
+
+    if (!buffer || !start || p < begin || p >= end)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    while (p + 2 <= end && p[0] >= 2 && p + p[0] <= end)
+    {
+        if (type == -1 || p[1] == type) return (USB_COMMON_DESCRIPTOR *)p;
+        p += p[0];
+    }
+    SetLastError(ERROR_NOT_FOUND);
+    return NULL;
+}
+
+/***********************************************************************
+ *           WinUsb_ParseConfigurationDescriptor (winusb.@)
+ */
+USB_INTERFACE_DESCRIPTOR * WINAPI WinUsb_ParseConfigurationDescriptor(USB_CONFIGURATION_DESCRIPTOR *config,
+        void *start, LONG interface_number, LONG alt_setting, LONG class, LONG subclass, LONG protocol)
+{
+    UCHAR *p = start, *begin = (UCHAR *)config, *end;
+
+    TRACE("config %p, start %p, interface %ld, alt %ld, class %ld, subclass %ld, protocol %ld.\n",
+            config, start, interface_number, alt_setting, class, subclass, protocol);
+
+    if (!config || !start)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+    end = begin + config->wTotalLength;
+    if (p < begin || p >= end)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return NULL;
+    }
+
+    while (p + 2 <= end && p[0] >= 2 && p + p[0] <= end)
+    {
+        if (p[1] == USB_INTERFACE_DESCRIPTOR_TYPE && p[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            USB_INTERFACE_DESCRIPTOR *iface = (USB_INTERFACE_DESCRIPTOR *)p;
+
+            if ((interface_number == -1 || iface->bInterfaceNumber == interface_number)
+                    && (alt_setting == -1 || iface->bAlternateSetting == alt_setting)
+                    && (class == -1 || iface->bInterfaceClass == class)
+                    && (subclass == -1 || iface->bInterfaceSubClass == subclass)
+                    && (protocol == -1 || iface->bInterfaceProtocol == protocol))
+                return iface;
+        }
+        p += p[0];
+    }
+    SetLastError(ERROR_NOT_FOUND);
+    return NULL;
+}
