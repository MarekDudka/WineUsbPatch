+/* Buffered ioctls cannot report a transfer size larger than their output
+ * buffer, which is empty for OUT transfers. Remember the length of
+ * asynchronous OUT transfers so WinUsb_GetOverlappedResult() can report it. */
+#define MAX_PENDING_WRITES 128
+
+static CRITICAL_SECTION write_cs;
+static CRITICAL_SECTION_DEBUG write_cs_debug =
+{
+    0, 0, &write_cs,
+    { &write_cs_debug.ProcessLocksList, &write_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": write_cs") }
+};
+static CRITICAL_SECTION write_cs = { &write_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct
+{
+    OVERLAPPED *overlapped;
+    DWORD length;
+} pending_writes[MAX_PENDING_WRITES];
+static unsigned int pending_write_next;
+
+static void remember_write(OVERLAPPED *overlapped, DWORD length)
+{
+    unsigned int i;
+
+    EnterCriticalSection(&write_cs);
+    for (i = 0; i < MAX_PENDING_WRITES; ++i)
+        if (pending_writes[i].overlapped == overlapped) break;
+    if (i == MAX_PENDING_WRITES)
+    {
+        i = pending_write_next++ % MAX_PENDING_WRITES;
+    }
+    pending_writes[i].overlapped = overlapped;
+    pending_writes[i].length = length;
+    LeaveCriticalSection(&write_cs);
+}
+
+static BOOL take_write(OVERLAPPED *overlapped, DWORD *length)
+{
+    BOOL found = FALSE;
+    unsigned int i;
+
+    EnterCriticalSection(&write_cs);
+    for (i = 0; i < MAX_PENDING_WRITES; ++i)
+    {
+        if (pending_writes[i].overlapped == overlapped)
+        {
+            *length = pending_writes[i].length;
+            pending_writes[i].overlapped = NULL;
+            found = TRUE;
+            break;
+        }
+    }
+    LeaveCriticalSection(&write_cs);
+    return found;
+}
+
+/* Traffic capture: WINEDEBUG=+usbcap prints every transfer with a hex dump. */
+static void capture(const char *dir, UCHAR ep, const UCHAR *data, ULONG length, const char *extra)
+{
+    static const char hex[] = "0123456789abcdef";
+    char text[3 * 240 + 8], *out = text;
+    ULONG i, n = min(length, 240);
+
+    if (!TRACE_ON(usbcap)) return;
+    for (i = 0; i < n; ++i)
+    {
+        *out++ = hex[data[i] >> 4];
+        *out++ = hex[data[i] & 15];
+        *out++ = ' ';
+    }
+    if (length > n) { *out++ = '.'; *out++ = '.'; *out++ = '.'; }
+    *out = 0;
+    TRACE_(usbcap)("%s ep=%02x len=%lu%s: %s\n", dir, ep, length, extra, text);
+}
+
+#define MAX_PENDING_READS 128
+static struct
+{
+    OVERLAPPED *overlapped;
+    UCHAR *buffer;
+    UCHAR ep;
+} pending_reads[MAX_PENDING_READS];
+static unsigned int pending_read_next;
+
+static void remember_read(OVERLAPPED *overlapped, UCHAR *buffer, UCHAR ep)
+{
+    unsigned int i;
+
+    EnterCriticalSection(&write_cs);
+    for (i = 0; i < MAX_PENDING_READS; ++i)
+        if (pending_reads[i].overlapped == overlapped) break;
+    if (i == MAX_PENDING_READS) i = pending_read_next++ % MAX_PENDING_READS;
+    pending_reads[i].overlapped = overlapped;
+    pending_reads[i].buffer = buffer;
+    pending_reads[i].ep = ep;
+    LeaveCriticalSection(&write_cs);
+}
+
+static void complete_read(OVERLAPPED *overlapped, DWORD length)
+{
+    unsigned int i;
+
+    EnterCriticalSection(&write_cs);
+    for (i = 0; i < MAX_PENDING_READS; ++i)
+    {
+        if (pending_reads[i].overlapped == overlapped)
+        {
+            capture("IN ", pending_reads[i].ep, pending_reads[i].buffer, length, "");
+            pending_reads[i].overlapped = NULL;
+            break;
+        }
+    }
+    LeaveCriticalSection(&write_cs);
+}
+
+static BOOL device_ioctl(struct winusb *winusb, DWORD code, void *in, DWORD in_size,
+        void *out, DWORD out_size, DWORD *ret_size, OVERLAPPED *overlapped)
+{
+    OVERLAPPED sync = {0};
+    DWORD size = 0;
+    BOOL ret;
+
+    if (overlapped)
+        return DeviceIoControl(winusb->device, code, in, in_size, out, out_size, ret_size, overlapped);
+
+    if (!(sync.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL))) return FALSE;
+    ret = DeviceIoControl(winusb->device, code, in, in_size, out, out_size, &size, &sync);
+    if (!ret && GetLastError() == ERROR_IO_PENDING)
+        ret = GetOverlappedResult(winusb->device, &sync, &size, TRUE);
+    CloseHandle(sync.hEvent);
+    if (ret_size) *ret_size = size;
+    return ret;
+}
+
+static struct pipe_info *find_pipe(struct winusb *winusb, UCHAR address)
+{
+    unsigned int i;
+
+    for (i = 0; i < winusb->pipe_count; ++i)
+        if (winusb->pipes[i].address == address) return &winusb->pipes[i];
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return NULL;
+}
+
+/* Collect the endpoints of the current alternate setting of our interface. */
+static void parse_pipes(struct winusb *winusb)
+{
+    const UCHAR *p = winusb->config, *end = winusb->config + winusb->config_length;
+    BOOL in_alt = FALSE;
+
+    winusb->pipe_count = 0;
+    while (p + 2 <= end && p[0] >= 2 && p + p[0] <= end)
+    {
+        if (p[1] == USB_INTERFACE_DESCRIPTOR_TYPE && p[0] >= sizeof(USB_INTERFACE_DESCRIPTOR))
+        {
+            const USB_INTERFACE_DESCRIPTOR *iface = (const USB_INTERFACE_DESCRIPTOR *)p;
+            in_alt = iface->bInterfaceNumber == winusb->interface_number
+                    && iface->bAlternateSetting == winusb->alt_setting;
+        }
+        else if (p[1] == USB_ENDPOINT_DESCRIPTOR_TYPE && in_alt && p[0] >= sizeof(USB_ENDPOINT_DESCRIPTOR)
+                && winusb->pipe_count < MAX_PIPES)
+        {
+            const USB_ENDPOINT_DESCRIPTOR *ep = (const USB_ENDPOINT_DESCRIPTOR *)p;
+            struct pipe_info *pipe = &winusb->pipes[winusb->pipe_count++];
+
+            pipe->address = ep->bEndpointAddress;
+            pipe->type = ep->bmAttributes & 3;
+            pipe->max_packet = ep->wMaxPacketSize;
+            pipe->interval = ep->bInterval;
+            pipe->timeout = 0;
+        }
+        p += p[0];
+    }
+}
